# Copy to .env (or paste into Portainer → Stack → Environment variables). All optional.

# Image tag to run: "latest", or pin a release such as "1.0.0"
PHOTOSORTER_TAG=latest
# Port on the NAS: http://<nas-ip>:8420
PHOTOSORTER_PORT=8420
TZ=Europe/Warsaw

# Host folders
PHOTOS_INBOX=/mnt/Data/pictures/!sort
PHOTOS_SORTED=/mnt/Data/pictures/!sorted
APPDATA=/mnt/Legend/containers/persistent_storage/photosorter2claude

# Optional login (HTTP basic auth). Leave empty to disable.
PHOTOSORTER_AUTH_USER=
PHOTOSORTER_AUTH_PASSWORD=

# Optional: only answer to these host names (comma separated), e.g. 192.168.50.2,photos.lan
PHOTOSORTER_ALLOWED_HOSTS=

# Optional: your e-mail, sent to OpenStreetMap Nominatim as contact (recommended by their usage policy)
PHOTOSORTER_CONTACT_EMAIL=

PHOTOSORTER_LOG_LEVEL=INFO
